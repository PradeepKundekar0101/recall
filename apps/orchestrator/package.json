{
  "name": "orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx src/eval/run.ts",
    "journey:check": "tsx src/journey/check.ts",
    "twilio:check": "tsx src/twilio-check.ts",
    "sandbox:mock": "tsx src/sandbox/mock-server.ts",
    "voice:check": "tsx src/voice-check.ts",
    "voice:calibrate": "tsx src/voice-calibrate.ts",
    "voice:replay": "tsx src/voice-replay.ts",
    "llm:check": "tsx src/llm-check.ts",
    "normalise:check": "tsx src/engine/normalise.check.ts",
    "dialogue:check": "tsx src/engine/dialogue.check.ts",
    "tts:check": "tsx src/voice/tts.check.ts",
    "transport:check": "tsx src/transports/twilio.check.ts",
    "setup:check": "tsx src/leads/setup.check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@google/genai": "^1.34.0",
    "openai": "^6.10.0",
    "@recall/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "twilio": "^5.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
