# ---- Twilio (required for PSTN; sim transport works without) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public https base of the orchestrator, used for TwiML + media stream URLs.
# Local dev: run `ngrok http 8080` and paste the https URL here.
PUBLIC_BASE_URL=

# ---- Supabase (call log + audit trail; in-memory without it) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Speech to text ----
# scribe (default) | deepgram. Build and test against scribe; deepgram is the
# fallback if Scribe wobbles on the venue network.
STT_PROVIDER=scribe
ELEVENLABS_API_KEY=
STT_MODEL=scribe_v2_realtime
# Deepgram fallback only.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ---- Text to speech ----
ELEVENLABS_VOICE_ID=
TTS_MODEL=eleven_flash_v2_5
# Where pre-rendered ulaw for the fixed script lines is cached on disk.
PRERENDER_DIR=.prerender

# ---- LLM ----
# anthropic | openai | openrouter | gemini. Whichever key is set wins if blank,
# preferring a direct key over the gateway - OpenRouter adds a network hop and the
# turn budget only allows 250ms to first token. Measure with `pnpm llm:check`.
# gemini is deliberately not a default: measure its TTFT in rehearsal first.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DIALOGUE_MODEL=
ESCALATION_MODEL=

# ---- Runtime ----
PORT=8080
# echo: repeat back what STT heard. Tonight's infrastructure target.
# journey: run the Energy slot-filling dialogue.
CALL_MODE=echo
# 1 = no vendor calls; STT/TTS/LLM run off canned fixtures. Lets the loop boot dry.
MOCK_VOICE=1
# sim | pstn
TRANSPORT=sim
IGNORE_CALL_WINDOW=1

# ---- Disconnect handling ----
# Silence on an open question: nudge, nudge again, then close as abandoned.
SILENCE_NUDGE_MS=6000
SILENCE_SECOND_NUDGE_MS=12000
SILENCE_ABANDON_MS=18000

# ---- Sandbox ----
SANDBOX_URL=http://localhost:4001
SANDBOX_AUTH_HEADER=
MOCK_SANDBOX_PORT=4001

# ---- Guardrails ----
# Comma-separated E.164. The dial path refuses any number not on this list.
TEST_NUMBERS=
# Second test phone that warm handoffs transfer to.
HANDOFF_NUMBER=

# ---- Web ----
NEXT_PUBLIC_API_BASE=http://localhost:8080
